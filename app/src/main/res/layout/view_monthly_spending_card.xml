<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#EFEBFD"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <!-- Title & Purple Pill -->
        <TextView
            android:id="@+id/tvMonthlyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chi tiêu tháng này"
            android:textColor="#5C5572"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMonthlyPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_green"
            android:backgroundTint="#7C4DFF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="3,85 triệu đ"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Main Amount -->
        <TextView
            android:id="@+id/tvMonthlyAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="3.850.000 đ"
            android:textColor="#1E1B2E"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMonthlyTitle" />

        <!-- Subtitle Comparison -->
        <TextView
            android:id="@+id/tvMonthlyComparison"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="↓ 12%  so với tháng trước"
            android:textColor="#00B894"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMonthlyAmount" />

        <!-- Weekly Summary Bar Chart on Right -->
        <LinearLayout
            android:id="@+id/layoutBarChart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMonthlyPill">

            <!-- Bar T1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="14dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_pill_green"
                    android:backgroundTint="#D1C7FB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="T1"
                    android:textColor="#7A7889"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bar T2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="14dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_pill_green"
                    android:backgroundTint="#D1C7FB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="T2"
                    android:textColor="#7A7889"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bar T3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="14dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_pill_green"
                    android:backgroundTint="#D1C7FB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="T3"
                    android:textColor="#7A7889"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bar T4 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="14dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_pill_green"
                    android:backgroundTint="#D1C7FB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="T4"
                    android:textColor="#7A7889"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Bar T5 (Active) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="14dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pill_green"
                    android:backgroundTint="#7C4DFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="T5"
                    android:textColor="#7C4DFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bar T6 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="14dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_pill_green"
                    android:backgroundTint="#D1C7FB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="T6"
                    android:textColor="#7A7889"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>