<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spendly_bg"
    android:fillViewport="true"
    tools:context=".presentation.auth.register.RegisterFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spendly_space_24"
        android:paddingVertical="@dimen/spendly_space_16">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/spendly_touch_target_min"
            android:layout_height="@dimen/spendly_touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_back"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/spendly_primary"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spendly_space_16"
            android:text="@string/spendly_register_title"
            android:textAppearance="@style/TextAppearance.Spendly.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spendly_space_8"
            android:text="@string/spendly_register_description"
            android:textAppearance="@style/TextAppearance.Spendly.Body"
            android:textColor="@color/spendly_muted" />

        <!-- Hiện khi lưu tài khoản thất bại -->
        <TextView
            android:id="@+id/tvFormError"
            style="@style/Widget.Spendly.Auth.Banner"
            android:background="@drawable/bg_spendly_notice_error"
            android:textColor="@color/spendly_danger" />

        <TextView
            style="@style/Widget.Spendly.Auth.Label"
            android:layout_marginTop="@dimen/spendly_space_24"
            android:text="@string/spendly_full_name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFullName"
            style="@style/Widget.Spendly.Auth.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:hint="@string/auth_name_hint"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="60"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Spendly.Auth.Field" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Spendly.Auth.Label"
            android:text="@string/spendly_email" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Spendly.Auth.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/auth_email_hint"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Spendly.Auth.Field" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Spendly.Auth.Label"
            android:text="@string/auth_phone_optional" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            style="@style/Widget.Spendly.Auth.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phoneNational"
                android:hint="@string/auth_phone_hint"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Spendly.Auth.Field" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Spendly.Auth.Label"
            android:text="@string/spendly_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Spendly.Auth.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/spendly_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/spendly_password_hint"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Spendly.Auth.Field" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.Spendly.Auth.Label"
            android:text="@string/spendly_confirm_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmPassword"
            style="@style/Widget.Spendly.Auth.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/spendly_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/spendly_repeat_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Spendly.Auth.Field" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spendly_space_8"
            android:text="@string/spendly_registration_terms"
            android:textAppearance="@style/TextAppearance.Spendly.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.Spendly.Auth.Button"
            android:layout_marginTop="@dimen/spendly_space_24"
            android:text="@string/spendly_create_account" />

        <TextView
            android:id="@+id/tvGoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spendly_space_8"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="@dimen/spendly_touch_target_min"
            android:text="@string/spendly_existing_account"
            android:textAppearance="@style/TextAppearance.Spendly.Label"
            android:textColor="@color/spendly_primary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
