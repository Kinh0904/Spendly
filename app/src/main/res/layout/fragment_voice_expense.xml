<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F4FC">
 <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:padding="20dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/view_toolbar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/nav_back" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="‹" android:textSize="30sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ghi bằng giọng nói" android:textSize="20sp" android:textStyle="bold"/></LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
   <LinearLayout android:id="@+id/voice_ready" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="130dp" android:layout_height="130dp" android:background="#E9E2FF" android:gravity="center" android:text="♩" android:textColor="#8058F5" android:textSize="64sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Chạm để nói" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ví dụ: cà phê 30k" android:textColor="#858392"/><com.google.android.material.button.MaterialButton android:id="@+id/start_voice" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="22dp" android:text="Bắt đầu ghi" android:textColor="#FFFFFF" app:backgroundTint="#8058F5" app:cornerRadius="16dp"/><TextView android:id="@+id/voice_example" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Xem hướng dẫn và ví dụ" android:textColor="#8058F5"/></LinearLayout>
   <LinearLayout android:id="@+id/voice_error" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mình chưa nghe rõ" android:textSize="22sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Thử nói ngắn hơn, ví dụ ‘cà phê 30k’" android:textColor="#858392"/><com.google.android.material.button.MaterialButton android:id="@+id/try_again" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="Thử lại" android:textColor="#FFFFFF" app:backgroundTint="#8058F5"/><com.google.android.material.button.MaterialButton android:id="@+id/manual_entry" android:layout_width="match_parent" android:layout_height="52dp" android:text="Nhập tay"/></LinearLayout>
   <LinearLayout android:id="@+id/voice_review" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone"><TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:padding="14dp" android:text="🎙  Câu đã nói: ăn sáng · bốn lăm nghìn"/><com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><EditText android:layout_width="match_parent" android:layout_height="56dp" android:inputType="number" android:text="45.000 đ" android:textSize="25sp"/><EditText android:layout_width="match_parent" android:layout_height="48dp" android:text="Tên: Ăn sáng"/><TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="Danh mục: Ăn uống"/><TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="Ngày: Hôm nay"/></LinearLayout></com.google.android.material.card.MaterialCardView><View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/repeat_voice" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Nói lại"/><com.google.android.material.button.MaterialButton android:id="@+id/save_voice" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Lưu" android:textColor="#FFFFFF" app:backgroundTint="#8058F5"/></LinearLayout></LinearLayout>
  </FrameLayout>
 </LinearLayout><include android:id="@+id/view_toolbar" layout="@layout/view_toolbar" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
