<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#201B32">
 <TextView android:id="@+id/close_scanner" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="×" android:textColor="#FFFFFF" android:textSize="32sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
 <TextView android:layout_width="wrap_content" android:layout_height="56dp" android:gravity="center" android:text="Quét hóa đơn" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <TextView android:id="@+id/flash_button" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:text="⚡" android:textColor="#FFFFFF" android:textSize="23sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <FrameLayout android:id="@+id/scan_frame" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginHorizontal="48dp" android:layout_marginVertical="42dp" android:background="@drawable/bg_scan_frame" app:layout_constraintTop_toBottomOf="@id/close_scanner" app:layout_constraintBottom_toTopOf="@id/scan_caption" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"><View android:layout_width="match_parent" android:layout_height="2dp" android:layout_gravity="center" android:background="#8058F5"/></FrameLayout>
 <TextView android:id="@+id/scan_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Căn chỉnh hóa đơn vào giữa khung hình\nCamera/OCR sẽ hoạt động sau khi được tích hợp." android:textColor="#E0DDEC" android:textSize="12sp" android:padding="10dp" app:layout_constraintBottom_toTopOf="@id/scan_modes" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <LinearLayout android:id="@+id/scan_modes" android:layout_width="wrap_content" android:layout_height="48dp" android:orientation="horizontal" app:layout_constraintBottom_toTopOf="@id/scan_actions" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"><TextView android:id="@+id/manual_receipt" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="12dp" android:text="Thủ công" android:textColor="#A986FF"/><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="•" android:textColor="#A986FF"/><TextView android:id="@+id/ai_receipt" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="12dp" android:text="Tự động AI" android:textColor="#A986FF"/></LinearLayout>
 <LinearLayout android:id="@+id/scan_actions" android:layout_width="match_parent" android:layout_height="106dp" android:gravity="center" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent"><TextView android:id="@+id/gallery_button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▧\nThư viện" android:textColor="#FFFFFF"/><com.google.android.material.button.MaterialButton android:id="@+id/capture_receipt" android:layout_width="70dp" android:layout_height="70dp" android:text="" app:backgroundTint="#8058F5" app:cornerRadius="35dp" app:strokeColor="#FFFFFF" app:strokeWidth="2dp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◴\nLịch sử" android:textColor="#FFFFFF"/></LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
