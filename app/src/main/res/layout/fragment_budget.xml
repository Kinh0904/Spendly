<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F4FC">
 <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:padding="18dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/view_toolbar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/nav_back" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="#252337"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Ngân sách tháng 3" android:textColor="#252337" android:textSize="21sp" android:textStyle="bold"/></LinearLayout>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="#E8E1FF" app:cardCornerRadius="22dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:id="@+id/total_used" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đã dùng 3.850.000 / 5.000.000 đ" android:textColor="#28243A" android:textSize="21sp"/><com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/total_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:progress="77" app:indicatorColor="#8058F5" app:trackColor="#D1C7FB" app:trackThickness="8dp"/><TextView android:id="@+id/remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Còn 1.150.000 đ" android:textColor="#777584" android:textSize="12sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Hạn mức theo danh mục" android:textColor="#252337" android:textSize="16sp" android:textStyle="bold"/>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"><LinearLayout android:id="@+id/budget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
  <com.google.android.material.button.MaterialButton android:id="@+id/set_limit" android:layout_width="match_parent" android:layout_height="52dp" android:text="Đặt hạn mức" android:textColor="#FFFFFF" app:backgroundTint="#8058F5" app:cornerRadius="16dp"/>
 </LinearLayout>
 <include android:id="@+id/view_toolbar" layout="@layout/view_toolbar" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
