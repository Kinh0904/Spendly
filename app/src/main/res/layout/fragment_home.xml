<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".presentation.home.HomeFragment">

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Header -->
            <include
                android:id="@+id/view_home_header"
                layout="@layout/view_home_header" />

            <!-- 2. Monthly Spending Card -->
            <include
                android:id="@+id/view_monthly_spending_card"
                layout="@layout/view_monthly_spending_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- 3. Dashboard Row (Spending Trend Card + Today Spending Card) -->
            <include
                android:id="@+id/view_dashboard_row"
                layout="@layout/view_dashboard_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- 4. Quick Add Section -->
            <include
                android:id="@+id/view_quickadd_section"
                layout="@layout/view_quickadd_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- 5. Recent Section (Recent Activity Card + Recent Categories Card) -->
            <include
                android:id="@+id/view_recent_section"
                layout="@layout/view_recent_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- 6. Utilities Section -->
            <include
                android:id="@+id/view_utilities_section"
                layout="@layout/view_utilities_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 7. Bottom Navigation Toolbar (Unchanged) -->
    <include
        android:id="@+id/bottom_toolbar"
        layout="@layout/view_toolbar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>