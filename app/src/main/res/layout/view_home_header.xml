<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <!-- Left Side: Greeting & Subtitle -->
    <TextView
        android:id="@+id/tvGreetingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chào bạn!"
        android:textColor="#1E1B2E"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutDateSegment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGreetingTitle">

        <TextView
            android:id="@+id/tvHeaderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ Ba, 12 thg 3, 2024"
            android:textColor="#7A7889"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvHeaderDaySegment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_green"
            android:backgroundTint="#FFF8E7"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="☀️ Buổi sáng"
            android:textColor="#D68910"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Side: Action Icons (Search & Profile) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Search Button -->
        <ImageView
            android:id="@+id/btnHeaderSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="#FFFFFF"
            android:contentDescription="Tìm kiếm"
            android:padding="10dp"
            android:src="@drawable/ic_search" />

        <!-- Profile Avatar Button -->
        <ImageView
            android:id="@+id/btnHeaderProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="#E3DCFF"
            android:contentDescription="Hồ sơ"
            android:padding="8dp"
            android:src="@drawable/ic_person" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>