<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="16dp">

    <!-- Color Dot -->
    <View
        android:id="@+id/viewCatColorDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_circle_avatar"
        android:backgroundTint="#FF7675" />

    <!-- Category Name -->
    <TextView
        android:id="@+id/tvCatName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:text="Ăn uống"
        android:textColor="#27243A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Percentage -->
    <TextView
        android:id="@+id/tvCatPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="38%"
        android:textColor="#7A768F"
        android:textSize="12sp" />

    <!-- Amount -->
    <TextView
        android:id="@+id/tvCatAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="360.000 đ"
        android:textColor="#27243A"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>