<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F4FC">
 <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:padding="22dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/view_toolbar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/nav_back" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="‹" android:textSize="30sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thêm khoản chi" android:textSize="21sp" android:textStyle="bold"/></LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Số tiền" android:textSize="14sp" android:textStyle="bold"/>
