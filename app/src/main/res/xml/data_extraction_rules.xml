<?xml version="1.0" encoding="utf-8"?><!--
   Quy tắc sao lưu và chuyển máy (Android 12 trở lên).
   Dữ liệu đăng nhập (mật khẩu đã băm, phiên đăng nhập) chỉ ở trên thiết bị này.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="spendly_auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spendly_auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
