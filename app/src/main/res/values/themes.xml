<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Spendly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_green_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_green_dark</item>
        <item name="android:colorBackground">@color/bg_mint_tint</item>
        <item name="android:statusBarColor">@color/bg_mint_tint</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Spendly" parent="Base.Theme.Spendly" />

    <!-- Custom Card Style -->
    <style name="Widget.Spendly.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>